---
import Layout from '../../layouts/Layout.astro';
import Filters from '../../components/Filters.astro';
import { categoryLabels, exams, kindLabels } from '../../lib/catalog';
import { examPath, official } from '../../lib/paths';
const years = [...new Set(exams.map(exam => exam.year))];
const forms = [...new Set(exams.map(exam => exam.form))].sort((a, b) => a.localeCompare(b, 'en', { numeric: true }));
---
<Layout title="Past-exam archive" active="exams">
  <div class="frame wide-page">
    <header class="page-intro">
      <h1>Past-exam archive</h1>
      <p class="subtitle" lang="zh">历年试卷目录</p>
      <p class="intro-note">Browse the index by year, question type, and form. <span lang="zh">按年份、题型和卷别浏览。</span></p>
      <div class="source-links"><a class="button button-light" href={official.archive}>AP Central released FRQs <span lang="zh">官方简答题</span></a></div>
    </header>
    <Filters noun="papers" years={years} forms={forms}>
      {exams.map(exam => {
        const label = categoryLabels[exam.category];
        const kind = kindLabels[exam.kind];
        return (
          <article class="exam-card" data-filter-item data-year={exam.year} data-kind={exam.kind} data-form={exam.form}
            data-search={`${exam.year} ${exam.kind} ${exam.form} ${kind.en} ${kind.zh} ${label.en} ${label.zh}`}>
            <div>
              <h2><a href={examPath(exam.id)}>{exam.year} {exam.kind} · {exam.form}</a></h2>
              <p class="source-meta">{exam.questions.length} indexed questions <span aria-hidden="true">·</span> <span lang="zh">{kind.zh}</span> <span aria-hidden="true">·</span> {label.en} <span lang="zh">{label.zh}</span></p>
            </div>
            <div class="entry-top">
              {exam.paperUrl && <a class="text-link" href={exam.paperUrl}>Official paper <span lang="zh">题卷</span></a>}
              {exam.scoringUrl && <a class="text-link" href={exam.scoringUrl}>Official scoring <span lang="zh">评分</span></a>}
            </div>
          </article>
        );
      })}
    </Filters>
    <details class="coverage-details">
      <summary>About the index <span lang="zh">收录说明</span></summary>
      <p>The archive reflects the collection used for this project. Sample and practice material is labeled in the index. Some entries provide only the year, form, question locator and topic.</p>
      <p lang="zh">目录以已核对的本地资料为准。样题和练习卷单独标注。部分卷别仅提供年份、试卷定位与考点。</p>
      <p>Other unidentified exam and practice sections in the older compilation are awaiting source review. <span lang="zh">旧汇编中年份或出处尚未确认的卷段仍待核对。</span></p>
    </details>
  </div>
</Layout>
