---
import { unit1Missions } from '../data/unit1-game';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const playUrl = `${base}play/`;
const letters = ['A', 'B', 'C'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101c38" />
    <meta name="description" content="Play six AP Microeconomics Unit 1 missions with original economic scenarios and step-by-step feedback." />
    <title>Market Missions · AP Microeconomics</title>
  </head>
  <body data-chinese="true">
    <a class="skip" href="#game-content">Skip to game</a>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href={base}><span class="brand-mark" aria-hidden="true">↗</span><span>AP Microeconomics</span></a>
        <div class="top-actions">
          <a href={base}>Question bank <span class="zh" lang="zh">题库</span></a>
          <button id="language" class="quiet-button" type="button" aria-pressed="true">中文辅助</button>
        </div>
      </div>
    </header>

    <main id="game-content" tabindex="-1">
      <section id="mission-map" aria-labelledby="map-title">
        <div class="map-heading">
          <div>
            <p class="eyebrow">UNIT 1 / BASIC ECONOMIC CONCEPTS</p>
            <h1 id="map-title" tabindex="-1">Market Missions</h1>
            <p class="map-zh zh" lang="zh">市场挑战</p>
            <p class="map-intro">Work through three decisions in each mission. A missed answer gives you a clue, and you can try again.</p>
            <p class="map-intro zh" lang="zh">每关有三个决策。选错会获得提示，可以继续尝试。</p>
          </div>
          <p class="map-progress"><strong id="completed-count">0 / 6</strong> <span>missions cleared<span class="zh" lang="zh">已通关</span></span></p>
        </div>
        <div class="mission-grid">
          {unit1Missions.map(mission => <a class="mission-card" href={`${playUrl}?topic=${mission.id}`} data-mission={mission.id}>
            <span class="mission-card-head"><span class="map-id">{mission.id}</span><span class="map-status" data-status={mission.id} hidden>Cleared <span class="zh" lang="zh">通关</span></span></span>
            <h2>{mission.title.en}</h2>
            <span class="card-zh zh" lang="zh">{mission.title.zh}</span>
            <span class="card-foot"><span>{mission.topic.en}<span class="zh" lang="zh">{mission.topic.zh}</span></span><span aria-hidden="true">↗</span></span>
          </a>)}
        </div>
      </section>

      <section id="mission-play" aria-labelledby="mission-title" hidden>
        <div class="level-topline">
          <button type="button" class="back-button" data-map>← Mission map <span class="zh" lang="zh">关卡地图</span></button>
          <p class="level-meta" id="level-topic"></p>
        </div>
        <div class="level-heading">
          <div>
            <h1 id="mission-title" tabindex="-1"></h1>
            <p id="mission-title-zh" class="level-zh zh" lang="zh"></p>
          </div>
          <ol class="steps" aria-label="Mission progress" id="progress-steps">
            <li>1</li><li>2</li><li>3</li>
          </ol>
        </div>

        <div class="play-grid">
          <aside class="context" aria-labelledby="context-title">
            <h2 id="context-title">Briefing <span class="zh" lang="zh">情境</span></h2>
            <p id="scenario-en"></p>
            <p id="scenario-zh" class="zh" lang="zh"></p>
            <div id="mission-figure" hidden>
              <canvas id="ppc-graph" width="640" height="430" role="img" aria-label="Radios on the horizontal axis and filters on the vertical axis. The production frontier connects (0,12), (2,10), (4,6) and (6,0). The proposed output is (4,8)."></canvas>
            </div>
            <div class="table-wrap" id="mission-data" hidden></div>
          </aside>

          <section class="arena" id="arena" data-outcome="ready" aria-labelledby="prompt-en">
            <div class="arena-inner">
              <div class="arena-head">
                <p class="stage-id" id="stage-id"></p>
                <span class="arena-icon" aria-hidden="true"><span></span></span>
              </div>
              <h2 id="prompt-en" tabindex="-1"></h2>
              <p id="prompt-zh" class="prompt-zh zh" lang="zh"></p>
              <div class="choice-grid" role="group" aria-label="Choose an answer">
                {letters.map((letter, index) => <button class="choice" type="button" data-choice={index} aria-keyshortcuts={`${index + 1} ${letter}`}>
                  <span class="target" aria-hidden="true">{letter}</span>
                  <span class="choice-copy"><strong data-choice-en></strong><span class="zh" lang="zh" data-choice-zh></span></span>
                  <span class="choice-key" aria-hidden="true">{index + 1}</span>
                  <span class="choice-state" data-choice-state></span>
                </button>)}
              </div>
              <div class="arena-footer">
                <p class="keyboard-help">Focus a choice to use <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd></p>
                <button id="restart" class="back-button" type="button">Restart mission <span class="zh" lang="zh">重开</span></button>
              </div>
              <div class="feedback" id="feedback" hidden>
                <strong id="feedback-title"></strong>
                <p id="feedback-en"></p>
                <p id="feedback-zh" class="zh" lang="zh"></p>
                <button id="continue" type="button" class="primary" hidden><span id="continue-en"></span><span id="continue-zh" class="zh" lang="zh"></span><span aria-hidden="true">→</span></button>
              </div>
              <p id="announcement" class="visually-hidden" role="status" aria-atomic="true"></p>
            </div>
          </section>
        </div>
      </section>

      <section class="recap" id="mission-recap" aria-labelledby="recap-title" hidden>
        <button type="button" class="back-button" data-map>← Mission map <span class="zh" lang="zh">关卡地图</span></button>
        <div class="recap-head">
          <p class="eyebrow">MISSION COMPLETE <span class="zh" lang="zh">任务完成</span></p>
          <h1 id="recap-title" tabindex="-1"></h1>
          <p id="recap-title-zh" class="level-zh zh" lang="zh"></p>
          <p id="recap-score"></p>
        </div>
        <ol id="recap-list" class="recap-list"></ol>
        <div class="recap-actions">
          <button id="next-mission" class="primary" type="button">Next mission <span class="zh" lang="zh">下一关</span><span aria-hidden="true">→</span></button>
          <button id="replay" class="quiet-button" type="button">Play again <span class="zh" lang="zh">再玩一次</span></button>
          <a id="topic-link" class="quiet-button" href={`${base}topics/1.1/`}>Review this topic <span class="zh" lang="zh">复习本节</span></a>
        </div>
      </section>

      <noscript><p>Enable JavaScript to play the missions. <a href={base}>Open the question bank.</a></p></noscript>
    </main>
  </body>
</html>

<script>
  import { unit1Missions, type Bilingual } from '../data/unit1-game';

  const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
  const get = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const set = (id: string, value: string) => { get(id).textContent = value; };
  const map = get('mission-map');
  const play = get('mission-play');
  const recap = get('mission-recap');
  const arena = get('arena');
  const languageButton = get<HTMLButtonElement>('language');
  const continueButton = get<HTMLButtonElement>('continue');
  const choices = Array.from(document.querySelectorAll<HTMLButtonElement>('.choice'));
  const progress = Array.from(get('progress-steps').children);
  const missionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-mission]'));
  const clearBadges = Array.from(document.querySelectorAll<HTMLElement>('[data-status]'));
  const bestKey = 'ap-micro.market-missions.completed.v1';
  const languageKey = 'ap-micro.market-missions.chinese.v1';

  function readLocal(key: string) {
    try { return localStorage.getItem(key); } catch { return null; }
  }

  function writeLocal(key: string, value: string) {
    try { localStorage.setItem(key, value); } catch { /* The mission stays playable without storage. */ }
  }

  const cleared = new Set((readLocal(bestKey) ?? '').split(',').filter(id => unit1Missions.some(mission => mission.id === id)));
  let showChinese = readLocal(languageKey) !== 'false';
  let missionIndex = 0;
  let stepIndex = 0;
  let mistakes = new Set<number>();
  let solved = false;
  let stepMistakes: number[] = [];
  let currentView: 'map' | 'play' | 'recap' = 'map';

  function applyChinese() {
    document.body.dataset.chinese = String(showChinese);
    languageButton.setAttribute('aria-pressed', String(showChinese));
  }

  function display(view: typeof currentView, heading?: string) {
    currentView = view;
    map.hidden = view !== 'map';
    play.hidden = view !== 'play';
    recap.hidden = view !== 'recap';
    if (heading) {
      get(heading).focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: 'instant' });
    }
  }

  function setLocation(id?: string) {
    const url = new URL(window.location.href);
    if (id) {
      url.searchParams.set('topic', id);
    } else {
      url.searchParams.delete('topic');
    }
    window.history.replaceState(null, '', url);
  }

  function updateMap() {
    set('completed-count', `${cleared.size} / ${unit1Missions.length}`);
    clearBadges.forEach(badge => { badge.hidden = !cleared.has(badge.dataset.status ?? ''); });
  }

  function labeledCopy(parent: HTMLElement, value: Bilingual) {
    parent.append(document.createTextNode(value.en));
    if (value.en !== value.zh) {
      const chinese = document.createElement('span');
      chinese.className = 'zh localized';
      chinese.lang = 'zh';
      chinese.textContent = value.zh;
      parent.append(chinese);
    }
  }

  function renderBriefing() {
    const mission = unit1Missions[missionIndex];
    const topic = get('level-topic');
    topic.replaceChildren();
    labeledCopy(topic, { en: `${mission.id} / ${mission.topic.en}`, zh: mission.topic.zh });
    set('scenario-en', mission.scenario.en);
    set('scenario-zh', mission.scenario.zh);
    get('mission-figure').hidden = mission.figure !== 'ppc';
    if (mission.figure === 'ppc') drawFrontier();

    const host = get('mission-data');
    const data = mission.table;
    host.hidden = !data;
    host.replaceChildren();
    if (!data) return;
    const table = document.createElement('table');
    labeledCopy(table.createCaption(), data.caption);
    const header = table.createTHead().insertRow();
    data.columns.forEach(label => {
      const cell = document.createElement('th');
      cell.scope = 'col';
      labeledCopy(cell, label);
      header.append(cell);
    });
    const body = table.createTBody();
    data.rows.forEach(values => {
      const row = body.insertRow();
      values.forEach(value => labeledCopy(row.insertCell(), value));
    });
    host.append(table);
  }

  function drawFrontier() {
    const canvas = get<HTMLCanvasElement>('ppc-graph');
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const left = 72;
    const bottom = 330;
    const x = (radios: number) => left + radios * 75;
    const y = (filters: number) => bottom - filters * 23;
    function stroke(points: readonly (readonly [number, number])[], color: string, width: number) {
      ctx!.beginPath();
      points.forEach(([a, b], index) => { if (index) ctx!.lineTo(a, b); else ctx!.moveTo(a, b); });
      ctx!.strokeStyle = color;
      ctx!.lineWidth = width;
      ctx!.stroke();
    }

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.font = '24px system-ui, sans-serif';
    ctx.fillStyle = '#d4e0f3';
    ctx.fillText('Filters', left, 37);
    for (const filters of [2, 4, 6, 8, 10, 12]) {
      stroke([[left, y(filters)], [x(6.6), y(filters)]], '#324668', 2);
      ctx.textAlign = 'right';
      ctx.fillText(String(filters), left - 12, y(filters) + 8);
    }
    for (const radios of [0, 2, 4, 6]) {
      ctx.textAlign = 'center';
      ctx.fillText(String(radios), x(radios), bottom + 33);
    }
    ctx.fillText('Radios', x(3), 411);
    stroke([[left, y(12.4)], [left, bottom], [x(6.6), bottom]], '#c4d0e3', 3);
    const frontier = [[0, 12], [2, 10], [4, 6], [6, 0]] as const;
    stroke(frontier.map(([a, b]) => [x(a), y(b)]), '#c8f582', 5);
    frontier.forEach(([a, b]) => {
      ctx.beginPath();
      ctx.arc(x(a), y(b), 6, 0, Math.PI * 2);
      ctx.fillStyle = '#c8f582';
      ctx.fill();
    });
    ctx.setLineDash([8, 8]);
    stroke([[left, y(8)], [x(4), y(8)], [x(4), bottom]], '#8ac8ff', 2);
    ctx.setLineDash([]);
    ctx.beginPath();
    ctx.arc(x(4), y(8), 9, 0, Math.PI * 2);
    ctx.fillStyle = '#96cfff';
    ctx.fill();
    ctx.textAlign = 'left';
    ctx.fillText('(4, 8)', x(4) + 13, y(8) - 7);
  }

  function showDecision(focus = false) {
    const { steps } = unit1Missions[missionIndex];
    const step = steps[stepIndex];
    mistakes = new Set();
    solved = false;
    arena.dataset.outcome = 'ready';
    get('feedback').hidden = true;
    continueButton.hidden = true;
    set('announcement', '');
    set('stage-id', `DECISION ${stepIndex + 1} / ${steps.length}`);
    set('prompt-en', step.prompt.en);
    set('prompt-zh', step.prompt.zh);
    progress.forEach((item, index) => {
      item.classList.toggle('done', index < stepIndex);
      if (index === stepIndex) item.setAttribute('aria-current', 'step');
      else item.removeAttribute('aria-current');
      item.setAttribute('aria-label', `Decision ${index + 1}${index < stepIndex ? ', complete' : ''}`);
    });
    choices.forEach((choice, index) => {
      choice.querySelector('[data-choice-en]')!.textContent = step.choices[index].text.en;
      choice.querySelector('[data-choice-zh]')!.textContent = step.choices[index].text.zh;
      choice.querySelector('[data-choice-state]')!.textContent = '';
      choice.disabled = false;
      choice.removeAttribute('data-answer');
      choice.removeAttribute('aria-disabled');
    });
    if (focus) get('prompt-en').focus();
  }

  function startMission(index: number, updateLocation = true) {
    const mission = unit1Missions[index];
    missionIndex = index;
    stepIndex = 0;
    stepMistakes = [];
    set('mission-title', mission.title.en);
    set('mission-title-zh', mission.title.zh);
    renderBriefing();
    showDecision();
    if (updateLocation) setLocation(mission.id);
    display('play', 'mission-title');
  }

  function submitChoice(index: number) {
    if (solved || mistakes.has(index)) return;
    const { steps } = unit1Missions[missionIndex];
    const step = steps[stepIndex];
    const correct = index === step.correct;
    const choice = choices[index];
    const result = correct ? step.explanation : step.choices[index].hint!;
    const feedbackTitle = correct ? 'Target secured' : 'Try a different answer';
    const feedbackTitleZh = correct ? '成功命中' : '换一个答案试试';
    const feedbackHeading = get('feedback-title');
    feedbackHeading.replaceChildren();
    labeledCopy(feedbackHeading, { en: feedbackTitle, zh: feedbackTitleZh });
    choice.dataset.answer = correct ? 'correct' : 'miss';
    choice.querySelector('[data-choice-state]')!.textContent = correct ? 'Correct' : 'Tried';
    arena.dataset.outcome = correct ? 'correct' : 'miss';
    set('feedback-en', result.en);
    set('feedback-zh', result.zh);
    get('feedback').hidden = false;
    set('announcement', showChinese ? `${feedbackTitle}. ${result.en} ${feedbackTitleZh}。${result.zh}` : `${feedbackTitle}. ${result.en}`);

    if (!correct) {
      mistakes.add(index);
      choice.setAttribute('aria-disabled', 'true');
      return;
    }

    solved = true;
    stepMistakes.push(mistakes.size);
    choices.forEach(button => { button.disabled = true; });
    const finishing = stepIndex === steps.length - 1;
    set('continue-en', finishing ? 'View recap' : 'Next decision');
    set('continue-zh', finishing ? '查看复盘' : '下一步');
    continueButton.hidden = false;
    continueButton.focus();
  }

  function completeMission() {
    const mission = unit1Missions[missionIndex];
    cleared.add(mission.id);
    writeLocal(bestKey, [...cleared].join(','));
    updateMap();
    set('recap-title', mission.title.en);
    set('recap-title-zh', mission.title.zh);
    const firstTry = stepMistakes.filter(count => count === 0).length;
    const score = get('recap-score');
    score.replaceChildren();
    labeledCopy(score, { en: `${firstTry} of ${mission.steps.length} decisions correct on the first try.`, zh: `${mission.steps.length} 步中有 ${firstTry} 步一次答对。` });
    const list = get('recap-list');
    list.replaceChildren();
    mission.steps.forEach((step, index) => {
      const item = document.createElement('li');
      const heading = document.createElement('h2');
      const takeaway = document.createElement('p');
      const attempts = document.createElement('p');
      const count = stepMistakes[index];
      attempts.className = 'attempts';
      labeledCopy(heading, step.prompt);
      labeledCopy(takeaway, step.explanation);
      labeledCopy(attempts, count === 0 ? { en: 'First try', zh: '一次答对' } : { en: `${count + 1} attempts`, zh: `共尝试 ${count + 1} 次` });
      item.append(heading, takeaway, attempts);
      list.append(item);
    });
    get<HTMLAnchorElement>('topic-link').href = `${base}topics/${mission.id}/`;
    get('next-mission').hidden = missionIndex >= unit1Missions.length - 1;
    display('recap', 'recap-title');
  }

  languageButton.addEventListener('click', () => {
    showChinese = !showChinese;
    applyChinese();
    writeLocal(languageKey, String(showChinese));
  });
  missionLinks.forEach((link, index) => link.addEventListener('click', event => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    startMission(index);
  }));
  document.querySelectorAll('[data-map]').forEach(button => button.addEventListener('click', () => {
    setLocation();
    display('map', 'map-title');
  }));
  choices.forEach((button, index) => button.addEventListener('click', () => submitChoice(index)));
  continueButton.addEventListener('click', () => {
    if (!solved) return;
    if (stepIndex === unit1Missions[missionIndex].steps.length - 1) {
      completeMission();
      return;
    }
    stepIndex += 1;
    showDecision(true);
  });
  for (const id of ['restart', 'replay']) {
    get(id).addEventListener('click', () => startMission(missionIndex));
  }
  get('next-mission').addEventListener('click', () => startMission(missionIndex + 1));
  document.addEventListener('keydown', event => {
    if (currentView !== 'play' || solved || event.repeat || event.ctrlKey || event.metaKey || event.altKey) return;
    if (!(document.activeElement instanceof HTMLButtonElement) || !choices.includes(document.activeElement)) return;
    const key = event.key.toUpperCase();
    const index = /^[123]$/.test(key) ? Number(key) - 1 : ['A', 'B', 'C'].indexOf(key);
    if (index < 0) return;
    event.preventDefault();
    submitChoice(index);
  });
  applyChinese();
  updateMap();
  const requested = new URLSearchParams(window.location.search).get('topic');
  const requestedIndex = unit1Missions.findIndex(mission => mission.id === requested);
  if (requestedIndex >= 0) startMission(requestedIndex, false);
</script>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0b1428;
    --card: #15243f;
    --card-raised: #1b2d50;
    --line: #344a6e;
    --ink: #edf4ff;
    --muted: #b2c4df;
    --blue: #9bcaff;
    --green: #c8f582;
    --red: #ffafb0;
    --mono: ui-monospace, Consolas, monospace;
    font-family: 'Inter', 'Segoe UI', system-ui, 'Microsoft YaHei', sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body { margin: 0; min-height: 100vh; color: var(--ink); background: radial-gradient(ellipse at 68% 4%, #193562, transparent 61rem), var(--bg); }
  body[data-chinese='false'] .zh { display: none !important; }
  a { color: inherit; text-decoration: none; }
  button { color: inherit; font: inherit; cursor: pointer; }
  h1, h2, p { margin: 0; }
  :focus-visible { outline: 3px solid var(--green); outline-offset: 4px; }
  h1:focus, h2:focus, main:focus { outline: none; }
  .visually-hidden, .skip:not(:focus) { position: absolute; block-size: 1px; inline-size: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .skip:focus { position: fixed; z-index: 2; inset: 0 auto auto 0; background: var(--green); color: var(--bg); padding: .8rem 1rem; }
  .localized { display: block; margin-top: .18rem; color: var(--muted); font-weight: 400; }
  .topbar { border-bottom: 1px solid var(--line); background: #0b1428e6; }
  .topbar-inner { margin: auto; padding: .72rem 0; width: min(1140px, calc(100% - 3rem)); display: flex; align-items: center; justify-content: space-between; gap: .7rem; }
  .brand, .top-actions { display: flex; align-items: center; gap: .85rem; }
  .brand { font-weight: 750; letter-spacing: -.025em; }
  .brand-mark { display: grid; place-items: center; flex: none; width: 35px; height: 35px; border-radius: 9px; background: var(--green); color: #182c22; font-size: 1.3rem; }
  .top-actions { color: var(--muted); font-size: .86rem; }
  .top-actions a { display: flex; flex-wrap: wrap; justify-content: end; gap: .2rem .35rem; }
  .top-actions a:hover, .back-button:hover { color: var(--ink); }
  .quiet-button, .primary { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; padding: .55rem .85rem; border: 1px solid var(--line); border-radius: .55rem; background: transparent; font-size: .87rem; font-weight: 650; min-height: 44px; }
  .quiet-button:hover, .quiet-button[aria-pressed='true'] { border-color: var(--blue); color: var(--ink); background: #28436c; }
  main { margin-inline: auto; width: min(1140px, calc(100% - 3rem)); padding-block: clamp(2.2rem, 6vw, 5rem) 4rem; }
  .map-heading { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: 2rem; }
  .eyebrow, .stage-id, .level-meta, .map-id { font-family: var(--mono); font-weight: 650; letter-spacing: .09em; text-transform: uppercase; }
  .eyebrow { margin-bottom: .65rem; color: var(--green); font-size: .8rem; }
  .eyebrow .zh { letter-spacing: normal; margin-left: .45rem; }
  h1 { font-size: clamp(2rem, 5.25vw, 4.65rem); font-weight: 750; line-height: 1.02; letter-spacing: -.065em; }
  .map-zh { margin-top: .55rem; color: var(--blue); font-size: clamp(1rem, 2.3vw, 1.6rem); font-weight: 620; }
  .map-intro { margin-top: .9rem; color: var(--muted); font-size: .97rem; line-height: 1.55; }
  .map-intro.zh { margin-top: .15rem; }
  .map-progress { flex: none; display: flex; align-items: center; gap: .65rem; padding: .7rem .85rem; border: 1px solid var(--line); border-radius: .7rem; background: var(--card); color: var(--muted); font-size: .8rem; }
